{
  "name": "dbdl-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:play": "vite -c vite.play.config.ts",
    "build:play": "vue-tsc -p play/tsconfig.json --noEmit && vite build -c vite.play.config.ts",
    "test:play": "vitest run play"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.11"
  }
}
