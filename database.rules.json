{
  "rules": {
    ".read": false,
    ".write": false,
    "roomIndex": {
      ".read": true,
      "$code": {
        ".write": "$code.matches(/^[A-Z2-9]{4}$/)",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('updatedAt').isNumber())"
      }
    },
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z2-9]{4}$/)",
        ".write": "$code.matches(/^[A-Z2-9]{4}$/)",
        "lobby": {
          ".validate": "newData.hasChildren(['host', 'createdAt'])"
        },
        "game": {
          ".validate": "!newData.exists() || (newData.child('rev').isNumber() && newData.child('json').isString() && newData.child('json').val().length < 2000000)"
        },
        "log": {
          "$round": {
            ".validate": "$round.matches(/^r[0-9]+$/) && newData.isString() && newData.val().length < 500000"
          }
        },
        "moves": {
          "$move": {
            ".validate": "$move.matches(/^m[0-9]{6}$/) && newData.isString() && newData.val().length < 20000"
          }
        },
        "pings": {
          "$member": {
            ".validate": "newData.hasChildren(['x', 'y', 'at', 'n']) && newData.child('x').isNumber() && newData.child('x').val() >= 0 && newData.child('x').val() <= 1 && newData.child('y').isNumber() && newData.child('y').val() >= 0 && newData.child('y').val() <= 1 && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('at').val() == now && (!data.exists() || now - data.child('at').val() >= 1000)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
