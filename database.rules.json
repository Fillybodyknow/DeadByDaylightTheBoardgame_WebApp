{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z2-9]{4}$/)",
        ".write": "$code.matches(/^[A-Z2-9]{4}$/)",
        "lobby": {
          ".validate": "newData.hasChildren(['host', 'createdAt'])"
        },
        "game": {
          ".validate": "!newData.exists() || (newData.child('rev').isNumber() && newData.child('json').isString() && newData.child('json').val().length < 2000000)"
        },
        "log": {
          "$round": {
            ".validate": "$round.matches(/^r[0-9]+$/) && newData.isString() && newData.val().length < 500000"
          }
        },
        "moves": {
          "$move": {
            ".validate": "$move.matches(/^m[0-9]{6}$/) && newData.isString() && newData.val().length < 20000"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
